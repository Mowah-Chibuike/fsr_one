<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fsr_one_robot">

  <xacro:macro name="fsr_one">

  <xacro:property name="PI" value="3.1415926535897931"/>

  <xacro:property name="base_mass" value="10.0" />
  <xacro:property name="base_width" value="0.496" />
  <xacro:property name="base_length" value="0.51" />
  <xacro:property name="base_height" value="0.06" />

  <xacro:property name="trunk_mass" value="5.0" />
  <xacro:property name="trunk_height" value="0.30" />

  <xacro:property name="wheel_mass" value="0.5" />
  <xacro:property name="wheel_len" value="0.03" />
  <xacro:property name="wheel_radius" value="0.04" />

  <xacro:property name="caster_wheel_mass" value="0.2" />
  <xacro:property name="caster_wheel_radius" value="0.04" />

  <xacro:property name="z_offset" value="-${base_height/2}" />

  <xacro:property name="wheel_i_perp"
    value="${wheel_mass / 12.0 * (3*wheel_radius*wheel_radius + wheel_len*wheel_len)}" />
  <xacro:property name="wheel_i_spin"
    value="${wheel_mass / 2.0 * wheel_radius*wheel_radius}" />
  <xacro:property name="caster_i"
    value="${caster_wheel_mass * 0.4 * caster_wheel_radius*caster_wheel_radius}" />

  <link name="base_footprint" />

  <link name="base_link">
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_length} ${base_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_length} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}" ixy="0.0" ixz="0.0"
        iyy="${base_mass / 12.0 * (base_width*base_width + base_height*base_height)}" iyz="0.0"
        izz="${base_mass / 12.0 * (base_width*base_width + base_length*base_length)}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin rpy="0 0 0" xyz="0 0 ${wheel_radius + base_height/2}" />
  </joint>


  <link name="trunk">
    <collision>
      <origin xyz="0 0 ${trunk_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_length} ${trunk_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 ${trunk_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_length} ${trunk_height}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <inertial>
      <origin xyz="0 0 ${trunk_height/2}" rpy="0 0 0"/>
      <mass value="${trunk_mass}"/>
      <inertia
        ixx="${trunk_mass / 12.0 * (base_length*base_length + trunk_height*trunk_height)}" ixy="0.0" ixz="0.0"
        iyy="${trunk_mass / 12.0 * (base_width*base_width + trunk_height*trunk_height)}" iyz="0.0"
        izz="${trunk_mass / 12.0 * (base_width*base_width + base_length*base_length)}"/>
    </inertial>
  </link>

  <joint name="trunk_joint" type="fixed">
    <parent link="base_link"/>
    <child link="trunk"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.09 0.151 ${z_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>

  <link name="left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>

  
    <visual>
      <origin xyz="${wheel_radius*0.6} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${wheel_radius*0.5} ${wheel_len*1.1} ${wheel_radius*0.3}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_i_perp}" ixy="0.0" ixz="0.0"
        iyy="${wheel_i_perp}" iyz="0.0"
        izz="${wheel_i_spin}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.09 -0.151 ${z_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>

  <link name="right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual>
      <origin xyz="${wheel_radius*0.6} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${wheel_radius*0.5} ${wheel_len*1.1} ${wheel_radius*0.3}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_i_perp}" ixy="0.0" ixz="0.0"
        iyy="${wheel_i_perp}" iyz="0.0"
        izz="${wheel_i_spin}"/>
    </inertial>
  </link>

  <joint name="caster_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_left_wheel"/>
    <origin xyz="0.16 0.125 ${z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="caster_left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_wheel_mass}"/>
      <inertia
        ixx="${caster_i}" ixy="0.0" ixz="0.0"
        iyy="${caster_i}" iyz="0.0"
        izz="${caster_i}"/>
    </inertial>
  </link>

  <joint name="caster_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_right_wheel"/>
    <origin xyz="0.16 -0.125 ${z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="caster_right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_wheel_mass}"/>
      <inertia
        ixx="${caster_i}" ixy="0.0" ixz="0.0"
        iyy="${caster_i}" iyz="0.0"
        izz="${caster_i}"/>
    </inertial>
  </link>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.015 0.003"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.002"/>
      <inertia
        ixx="${0.002 / 12.0 * (0.015*0.015 + 0.003*0.003)}" ixy="0" ixz="0"
        iyy="${0.002 / 12.0 * (0.02*0.02 + 0.003*0.003)}" iyz="0"
        izz="${0.002 / 12.0 * (0.02*0.02 + 0.015*0.015)}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find fsr_description)/urdf/lidar.xacro" />

  </xacro:macro>

</robot>
