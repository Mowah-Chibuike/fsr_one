<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fsr_one_robot">
  <xacro:arg name="use_sim" default="True" />

  <xacro:include filename="$(find fsr_description)/urdf/fsr_one_gazebo.xacro"/>

  <xacro:include filename="$(find fsr_description)/urdf/fsr_one_description.urdf.xacro" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find fsr_description)/urdf/fsr_one.materials.xacro" />

  <!-- Import fsr_one ros2_control description -->
  <xacro:include filename="$(find fsr_controllers)/ros2_control/fsr_one.ros2_control.xacro" />

  <xacro:fsr_one />

  <xacro:fsr_one_ros2_control use_sim="$(arg use_sim)" />

</robot>
