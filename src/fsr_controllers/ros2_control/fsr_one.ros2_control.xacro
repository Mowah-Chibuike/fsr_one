<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fsr_one_ros2_control" params="use_sim">

    <ros2_control name="robot_system" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>fsr_controllers/DiffDriveArduinoHardware</plugin>
          <param name="left_wheel_name">left_wheel_joint</param>
          <param name="right_wheel_name">right_wheel_joint</param>
          <param name="loop_rate">30</param>
          <param name="device">/dev/ttyACM0</param>
          <param name="baud_rate">57600</param>
          <param name="timeout_ms">3000</param>
          <param name="enc_counts_per_rev">3436</param>
          <param name="pid_p">20</param>
          <param name="pid_d">12</param>
          <param name="pid_i">0</param>
          <param name="pid_o">50</param>
        </xacro:unless>
      </hardware>

      <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
